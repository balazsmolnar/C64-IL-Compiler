{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/run.bat",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Presentation",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/C64Presentation/run.bat",
            "args": [],
            "cwd": "${workspaceFolder}/C64Presentation",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": ".NET Core DEBUG",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/compiler/bin/Debug/compiler.exe",
            "args": [
                "./demo/bin/debug/demo.dll",
                "./asm"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        // {
        //     "type": "asm",
        //     "request": "launch",
        //     "name": "C64",
        //     "pc": "$c000",
        //     "binary": "c:\\Balazs\\C64\\.cache\\asm\\test.prg"
        // }
        {
            // Requires the vscode-extension/ folder to be loaded first --
            // see vscode-extension/README.md. Omit "testSelector" to
            // auto-resolve it from the class/method the cursor is in.
            "name": "Debug C64 Test",
            "type": "c64test",
            "request": "launch",
            "testSelector": "StringInterpolationTests.Interpolation_SingleHoleNoLiteral"
        },
        {
            // Builds a debug copy of the program, runs it on VICE and stops
            // at breakpoints you've set in Demo/*.cs -- see
            // vscode-extension/README.md. Needs x64sc (VICE_EXE or
            // c:\tools\VICE\bin\x64sc.exe).
            "name": "Debug Demo on VICE",
            "type": "c64vice",
            "request": "launch",
            "program": "Demo"
        },
        {
            // Same as "Debug Demo on VICE" above, but builds/debugs
            // Hunchback/*.cs instead (asm/hunchback_debug/, prg/hunchback_debug.*
            // -- a separate debug build from the normal asm/hunchback +
            // prg/hunchback.prg, so this never touches that one).
            "name": "Debug Hunchback on VICE",
            "type": "c64vice",
            "request": "launch",
            "program": "Hunchback"
        },
        {
            // Runs every test in turn (fresh emulator per test, same as the
            // real suite), pausing only when one of them hits a breakpoint
            // you've set -- see vscode-extension/README.md.
            "name": "Debug All C64 Tests",
            "type": "c64test",
            "request": "launch",
            "testSelector": "*"
        }
    ]
}