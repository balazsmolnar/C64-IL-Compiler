<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<Optimize>true</Optimize>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Scene builds for looking at the deck without pressing keys
       (tools/presentation-shot.ps1):
         -p:StartSlide=N  boot straight into slide N (0-based)
         -p:Scene=HOLD    the slide stays up: "advance" is never pressed
         -p:Scene=AUTO    "advance" presses itself after a short wait -->
  <PropertyGroup>
    <StartSlide Condition="'$(StartSlide)' == ''">0</StartSlide>
    <DefineConstants Condition="'$(Scene)' != ''">$(DefineConstants);SCENE;SCENE_$(Scene)</DefineConstants>
    <!-- -Scene ENGINE: the engine gallery (Slides/EngineGallery.cs) instead of
         the deck, with the art extras (section icons) and without the deck's
         own slides, so that it fits. It holds each slide like -Scene HOLD. -->
    <!-- -Scene NAVTEST: AUTO plus a faked N and B press (Helper/KeyBoard.cs). -->
    <DefineConstants Condition="'$(Scene)' == 'NAVTEST'">$(DefineConstants);SCENE_AUTO</DefineConstants>
    <DefineConstants Condition="'$(Scene)' == 'ENGINE'">$(DefineConstants);ART_EXTRAS;SCENE_HOLD</DefineConstants>
  </PropertyGroup>
  <Target Name="WriteSceneConfig" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)SceneConfig.g.cs" Lines="namespace C64Presentation%3B static class SceneConfig { public const int StartSlide = $(StartSlide)%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)SceneConfig.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Remove="sprites.asm" />
    <EmbeddedResource Include="sprites.asm" />
    <!-- The engine's fonts and logo sprites (art/font, art/engine), the deck's
         pictures (art/presentation_art.py -> art/build; declared in Assets.cs),
         and picture_buffer.asm, the RAM the pictures on the disk (disk.txt) load into -->
    <EmbeddedResource Include="art\font\build\*.asm;art\engine\build\*.spr;art\build\*.img;art\build\*.spr;art\build\*.asm" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The gallery build leaves the deck's slides out, so that it fits. (The
       deck build needs no list: dead-code elimination drops the elements no
       deck slide uses.) -->
  <ItemGroup Condition="'$(Scene)' == 'ENGINE'">
    <Compile Remove="Slides\Part1\**;Slides\Part2\**;Slides\Part3\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\C64Lib\C64Lib.csproj" />
    <!-- Build order only: the post-build step runs Compiler.exe against the new runtime asm, so it must be current -->
    <ProjectReference Include="..\Compiler\Compiler.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

</Project>
