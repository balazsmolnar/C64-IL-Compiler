<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<Optimize>true</Optimize>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Scene builds for looking at the deck without pressing keys
       (tools/presentation-shot.ps1):
         -p:StartSlide=N  boot straight into slide N (0-based)
         -p:Scene=HOLD    the slide stays up: "advance" is never pressed
         -p:Scene=AUTO    "advance" presses itself after a short wait -->
  <PropertyGroup>
    <StartSlide Condition="'$(StartSlide)' == ''">0</StartSlide>
    <DefineConstants Condition="'$(Scene)' != ''">$(DefineConstants);SCENE;SCENE_$(Scene)</DefineConstants>
  </PropertyGroup>
  <Target Name="WriteSceneConfig" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)SceneConfig.g.cs" Lines="namespace C64Presentation%3B static class SceneConfig { public const int StartSlide = $(StartSlide)%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)SceneConfig.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Remove="sprites.asm" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="sprites.asm" />
    <!-- The deck's pictures (art/presentation_art.py -> art/build; declared in Assets.cs) -->
    <EmbeddedResource Include="art\build\*.img;art\build\*.spr" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\C64Lib\C64Lib.csproj" />
    <!-- Build order only: the post-build step runs Compiler.exe against the new runtime asm, so it must be current -->
    <ProjectReference Include="..\Compiler\Compiler.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

</Project>
