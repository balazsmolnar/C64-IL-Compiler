<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Torch.aas" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Torch.aas" />
    <!-- Converted art (tools/c64img.py -> .img, tools/c64spr.py -> .spr; see
         TECH.md). Embedded under the bare file name, so code says
         Resource = "room1.img". -->
    <EmbeddedResource Include="art\build\*.img;art\build\*.spr" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\C64Lib\C64Lib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <OutputType>Exe</OutputType>
    <!-- "dotnet build -p:Scene=COMBAT" defines SCENE_COMBAT: a build that
         boots straight into one game state, for looking at it in VICE
         without playing up to it (see tools/catacombs-shot.ps1). -->
    <DefineConstants Condition="'$(Scene)' != ''">$(DefineConstants);SCENE_$(Scene)</DefineConstants>
    <!-- Every ENC... scene (the encounter's states, see Encounter.cs) also defines SCENE_ENCOUNTER. -->
    <DefineConstants Condition="$(Scene.StartsWith('ENC'))">$(DefineConstants);SCENE_ENCOUNTER</DefineConstants>
  </PropertyGroup>

</Project>
