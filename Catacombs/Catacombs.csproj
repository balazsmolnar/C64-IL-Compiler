<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Torch.aas" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Torch.aas" />
    <EmbeddedResource Include="audio\music.asm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\C64Lib\C64Lib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <OutputType>Exe</OutputType>
    <!-- "dotnet build -p:Scene=COMBAT" defines SCENE_COMBAT: a build that
         boots straight into one game state, for looking at it in VICE
         without playing up to it (see tools/catacombs-shot.ps1). -->
    <DefineConstants Condition="'$(Scene)' != ''">$(DefineConstants);SCENE_$(Scene)</DefineConstants>
  </PropertyGroup>

</Project>
