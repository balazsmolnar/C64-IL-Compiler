<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="CharSet.asm" />
    <None Remove="GameData.asm" />
    <None Remove="SpriteData.asm" />
    <None Remove="sprHunchback.spt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CharSet.asm" />
    <EmbeddedResource Include="GameData.asm" />
    <EmbeddedResource Include="SpriteData.asm" />
    <EmbeddedResource Include="sprHunchback.spt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\C64Lib\C64Lib.csproj" />
    <!-- Build order only: the post-build step runs Compiler.exe against the new runtime asm, so it must be current -->
    <ProjectReference Include="..\Compiler\Compiler.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <OutputType>Exe</OutputType>
    <!-- "dotnet build -p:Scene=BELLS" defines SCENE and SCENE_BELLS: a build
         that skips the title, starts on one level and plays it by itself,
         for looking at it in VICE without sending keys (see
         tools/hunchback-shot.ps1 and Game.cs). -->
    <DefineConstants Condition="'$(Scene)' != ''">$(DefineConstants);SCENE;SCENE_$(Scene)</DefineConstants>
  </PropertyGroup>

</Project>
